# Servidor del cliente web de SynaptixFit (detrás de Traefik y Cloudflare).
# /api/* va al backend por la red interna de Docker; el resto es la aplicación Flutter.

# La IP real del usuario llega en CF-Connecting-IP (Cloudflare) y X-Forwarded-For (Traefik).
map $http_cf_connecting_ip $client_ip {
    ""      $proxy_add_x_forwarded_for;
    default $http_cf_connecting_ip;
}

# Calendario suscrito (ADR 0020): límite por IP para que nadie pruebe tokens a ritmo de máquina.
limit_req_zone $client_ip zone=calendar_feed:1m rate=30r/m;
# Recuperar la contraseña (ADR 0021): cada petición puede mandar un correo y el plan de Resend tiene un tope
# diario; el backend además limita a 3 por cuenta y hora.
limit_req_zone $client_ip zone=password_reset:1m rate=5r/m;
# Resumen semanal (ADR 0022): activarlo puede mandar un correo de confirmación; el backend además espera 10 min
# entre reenvíos. Los enlaces del correo llevan un token: límite contra quien pruebe tokens.
limit_req_zone $client_ip zone=weekly_email:1m rate=5r/m;
limit_req_zone $client_ip zone=weekly_email_links:1m rate=30r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 25m;   # subida de apuntes y archivos (el backend limita por su cuenta)

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    # Solo se sirve por HTTPS (Cloudflare): el navegador no volverá a intentar HTTP.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # El token de la ruta es una credencial: esta ruta no deja rastro en los registros (el de errores
    # también copia la petición), y Google o Apple la piden sin sesión.
    location ~ ^/api/v1/planner/calendar-feed/[^/]+\.ics$ {
        access_log off;
        error_log /dev/stderr crit;
        limit_req zone=calendar_feed burst=10 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Enlaces de los correos del resumen semanal (ADR 0022): el token va en la query; sin registro de acceso.
    location ~ ^/api/v1/notifications/weekly-email/(confirm|unsubscribe)$ {
        access_log off;
        error_log /dev/stderr crit;
        limit_req zone=weekly_email_links burst=10 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/v1/notifications/weekly-email {
        limit_req zone=weekly_email burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Archivos y medios por el dominio de la app (ADR 0024): en España algunos operadores bloquean las IP de
    # Cloudflare R2 durante el fútbol y el móvil no podía subir apuntes ni ver vídeos. Las IP de la app no
    # se ven afectadas y el servidor (en Francia) sí llega a R2. El DNS se resuelve en cada petición
    # (resolver de Docker): si R2 no está configurado, nginx arranca igual.
    resolver 127.0.0.11 ipv6=off valid=300s;

    # Subidas y descargas firmadas: misma ruta y mismo Host que firmó el backend, así que la firma vale.
    # La consulta lleva la firma: sin registro de acceso.
    location ^~ /storage/ {
        access_log off;
        error_log /dev/stderr crit;
        set $r2 ${R2_UPSTREAM};
        rewrite ^/storage(/.*)$ $1 break;
        proxy_pass $r2;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        # Por aquí pasan archivos de los usuarios: se comprueba el certificado de R2.
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Archivos privados: ni Cloudflare ni el navegador los guardan (una URL firmada caducada o un
        # archivo borrado no deben seguir sirviéndose). Se sirven desde el origen de la app, así que van
        # aislados (sandbox) y sin adivinar el tipo. add_header aquí anula los del server: se repiten.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # Vídeos e imágenes de los ejercicios (solo esa carpeta del bucket): Cloudflare los guarda en caché.
    location ^~ /media/ejercicios/ {
        set $media ${MEDIA_UPSTREAM};
        rewrite ^/media(/.*)$ $1 break;
        proxy_pass $media;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        # Sin «always»: un 404 no se guarda una semana en la caché.
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location = /api/v1/auth/password-reset {
        limit_req zone=password_reset burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;   # las peticiones de IA pueden tardar
    }

    # La aplicación cambia en cada despliegue con los mismos nombres de archivo: el navegador
    # revalida siempre (ETag) y solo descarga lo que cambió.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri $uri/ /index.html;
    }
}
