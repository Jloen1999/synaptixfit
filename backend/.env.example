# Copia este archivo como backend/.env y rellena los valores. Nunca subas .env al repositorio.

# Base de datos PostgreSQL 17.
# Local: valores de docker-compose.yml. Producción (Coolify): DB_HOST = uuid del recurso
# synaptixfit-db (hostname interno de la red infra-app-db), usuario de la app no superusuario.
# Alternativa: DB_URL=jdbc:postgresql://<host>:<puerto>/<base> sustituye a HOST/PORT/DATABASE.
# Motor de base de datos: elige la URL por defecto y la carpeta de migraciones
# (db/migration/<DB_VENDOR>). Hoy solo existe postgresql.
DB_VENDOR=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=synaptixfit
DB_USERNAME=synaptixfit
DB_PASSWORD=***

# JWT: secreto aleatorio de al menos 32 bytes (p. ej. `openssl rand -base64 48`)
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Orígenes permitidos para el cliente web (separados por comas; admite comodines de puerto)
CORS_ALLOWED_ORIGINS=http://localhost:*

# Google Sign-In: IDs de cliente OAuth aceptados (web, Android, iOS), separados por comas
GOOGLE_CLIENT_IDS=

# IA generativa (DeepSeek, API compatible con OpenAI). Solo lee texto: los PDF se convierten
# a texto en el servidor; las imágenes no se pueden analizar (AI_ATTACHMENT_UNSUPPORTED).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Lectura de fotos de apuntes con Tesseract (ADR 0040). Valores por defecto entre paréntesis.
# SYNAPTIXFIT_OCR_COMMAND=tesseract          (programa; en la imagen Docker ya está instalado)
# SYNAPTIXFIT_OCR_MAX_CONCURRENT=2           (lecturas a la vez en todo el servidor)
# SYNAPTIXFIT_OCR_TIMEOUT_SECONDS=60         (tiempo máximo por foto)
# SYNAPTIXFIT_OCR_QUEUE_WAIT_SECONDS=10      (espera por un hueco libre antes de decir «ocupado»)
# SYNAPTIXFIT_OCR_MEMORY_LIMIT_MB=0          (tope de memoria por lectura con prlimit; 0 = sin tope.
#                                             La imagen Docker fija 768)

# Cloudflare R2 (API compatible con S3)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=synaptixfit
R2_ACCESS_KEY=
R2_SECRET_KEY=
# URL pública del bucket (vídeos y GIF de ejercicios). Vacío si el bucket es privado.
R2_PUBLIC_BASE_URL=
# Producción (ADR 0024): archivos y medios a través del nginx de la app. En local, vacíos (directo a R2).
# R2_PROXY_BASE_URL=https://synaptixfit.jloenit.dev/storage
# MEDIA_PUBLIC_BASE_URL=https://synaptixfit.jloenit.dev/media

# Correo transaccional (Resend): recuperar la contraseña y resumen semanal. Sin clave no se envía nada.
# El remitente debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=SynaptixFit <no-reply@notifications.jloenit.dev>
# Dirección pública de la app web: base de los enlaces de los correos.
APP_PUBLIC_URL=http://localhost:5173
# Política de privacidad y condiciones (ADR 0034): quién responde de los datos y su correo de contacto.
# Salen en /privacidad, /condiciones y /eliminar-cuenta. Vacías: los textos dicen «pendiente de indicar».
# LEGAL_CONTROLLER_NAME=
# LEGAL_CONTACT_EMAIL=
# Resumen semanal por correo (opcional): cron en la zona del planificador; «-» lo desactiva.
# WEEKLY_EMAIL_CRON=0 0 19-23 * * SUN
# Clases dadas por asistidas al terminar (ADR 0029); «-» lo desactiva.
# CLASS_AUTO_ATTEND_CRON=0 */10 * * * *
