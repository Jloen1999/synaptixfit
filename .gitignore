# =============================
# Seguridad: secretos y credenciales
# =============================
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Credenciales OAuth / Google
**/client_secret_*.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Llaves y certificados privados
*.p12
*.jks
*.keystore
*.pem
*.key

# Variables locales de Cloudflare Workers
cloudflare/**/.dev.vars
cloudflare/**/.secrets*

# =============================
# Entornos locales (no publicar)
# =============================
.venv/
**/__pycache__/
*.pyc
*.pyo

# =============================
# Artefactos locales frecuentes
# =============================
app/.dart_tool/
app/build/
app/.flutter-plugins-dependencies

# =============================
# Archivos multimedia de ejercicios (pesados, no versionar)
# =============================
exercisedb/gifs_360x360/
exercisedb/gifs_720x720/
exercisedb/gifs_180x180/
exercisedb/gifs_1080x1080/
Gym Workout/

# Archivos de video para staging de R2 (binarios grandes, no versionar)
r2_staging/

# Videos originales de Demic (binarios grandes, no versionar)
demic/originales/
demic/*.mp4
demic/*.py

# Archivos obsoletos archivados
_archivo/

# Asistente IA interno
.aiassistant/

# IDE
.idea/
