# =============================
# Seguridad: secretos y credenciales
# =============================
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Credenciales OAuth / Google
**/client_secret_*.json
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Llaves y certificados privados
*.p12
*.jks
*.keystore
*.pem
*.key

# =============================
# Entornos locales (no publicar)
# =============================
.venv/
**/__pycache__/
*.pyc
*.pyo

# Artefactos de compilación (backend/ y frontend/ tienen además su propio .gitignore)
**/target/
**/build/
**/.dart_tool/

# Archivos obsoletos archivados
_archivo/

# Asistente IA interno
.aiassistant/

# IDE
.idea/

# Instaladores compilados (APK, app de escritorio): se guardan en local, no en git
dist/

# Documentos personales de ejemplo (datos reales): nunca al repositorio
docs/CARTA DE PAGO.pdf
