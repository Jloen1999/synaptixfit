  "Pantalla: página con sus estados": {
    "scope": "dart",
    "prefix": "sxpage",
    "description": "Página (screens/<feature>/<pantalla>/page/): crea el bloc con getIt y pinta carga (esqueleto), error con Reintentar, vacío y contenido. Espaciados de TokensSpacing",
    "body": [
      "import 'package:flutter/material.dart';",
      "import 'package:flutter_bloc/flutter_bloc.dart';",
      "",
      "import '${5:../../../../../app/di/app_di.dart}';",
      "import '${6:../../../../extensions/context_extensions.dart}';",
      "import '${7:../../../../theme/tokens.g.dart}';",
      "import '${8:../../../../widgets/widgets.dart}';",
      "import '../bloc/${TM_FILENAME_BASE/(.*)_page$/$1/}_bloc.dart';",
      "",
      "/// ${1:Qué ve la persona en esta pantalla}.",
      "class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} extends StatelessWidget {",
      "  const ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}({super.key, required this.id});",
      "",
      "  final String id;",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return BlocProvider(",
      "      create: (_) => getIt<${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Bloc>()",
      "        ..add(${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Event.started(id)),",
      "      child: Scaffold(",
      "        appBar: AppPageBar(",
      "          leading: const AppBackButton(fallback: ${2:XxxPaths.root}),",
      "          title: Text(context.localizations.${3:xxxTitle}),",
      "        ),",
      "        body: BlocBuilder<${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Bloc, ${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}State>(",
      "          builder: (context, state) => switch (state) {",
      "            ${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Loading() => const AppSkeletonList(count: 3),",
      "            ${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Failure(:final error) => AppErrorView(",
      "              error: error,",
      "              onRetry: () => context.read<${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Bloc>().add(",
      "                ${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Event.started(id),",
      "              ),",
      "            ),",
      "            ${TM_FILENAME_BASE/(.*)_page$/${1:/pascalcase}/}Loaded(:final ${4:data}) => ListView(",
      "              padding: const EdgeInsets.all(TokensSpacing.m),",
      "              children: [$0],",
      "            ),",
      "          },",
      "        ),",
      "      ),",
      "    );",
      "  }",
      "}"
    ]
  },

