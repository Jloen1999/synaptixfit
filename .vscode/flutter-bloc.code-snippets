{
  // Snippets del cliente de SynaptixFit (Flutter + BLoC + freezed + get_it). Todos empiezan por «sx» (SynaptixFit): escribe «sx» y
  // verás la lista con su descripción. Siguen frontend/CLAUDE.md: dominio sin Flutter, contratos *Contract,
  // AppResult, errores traducidos, cuatro estados y nada de valores visuales sueltos (todo de Tokens*).
  // El nombre de la clase sale del nombre del archivo: crea antes «mi_cosa_bloc.dart», «mi_cosa_use_case.dart»…
  // Tras crear clases freezed: dart run build_runner build --delete-conflicting-outputs

  // ---------------------------------------------------------------- dominio

  "Dominio: modelo freezed": {
    "scope": "dart",
    "prefix": "sxmodel",
    "description": "Modelo de dominio inmutable (domain/models/<feature>/) con freezed; sin JSON (eso es del DTO)",
    "body": [
      "import 'package:freezed_annotation/freezed_annotation.dart';",
      "",
      "part '${TM_FILENAME_BASE}.freezed.dart';",
      "",
      "/// ${1:Qué representa}.",
      "@freezed",
      "abstract class ${2:${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}} with _\\$${2} {",
      "  const factory ${2}({",
      "    required String id,",
      "    required ${3:String} ${4:name},",
      "  }) = _${2};",
      "}"
    ]
  },

  "Dominio: contrato de repositorio": {
    "scope": "dart",
    "prefix": "sxrepocontract",
    "description": "Contrato del repositorio (domain/repositories/): lo que el dominio pide a la capa de datos. Devuelve AppResult, nunca lanza",
    "body": [
      "import '../models/result/app_result.dart';",
      "",
      "/// ${1:Qué datos gestiona}.",
      "abstract interface class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} {",
      "  Future<AppResult<${2:Modelo}>> ${3:get}(String id);",
      "}"
    ]
  },

  "Dominio: caso de uso": {
    "scope": "dart",
    "prefix": "sxusecase",
    "description": "Caso de uso (domain/use_cases/<feature>/): contrato *Contract + implementación que delega en el repositorio. Una acción. Regístralo con sxdilazy",
    "body": [
      "import '${3:../../models/result/app_result.dart}';",
      "import '${4:../../repositories/xxx_repository_contract.dart}';",
      "",
      "/// ${1:Qué hace, en una línea}.",
      "abstract interface class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Contract {",
      "  Future<AppResult<${2:Modelo}>> call(${5:String id});",
      "}",
      "",
      "/// Implementa [${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Contract] con",
      "/// [${6:XxxRepositoryContract}].",
      "class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}",
      "    implements ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Contract {",
      "  const ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}(this._repository);",
      "",
      "  final ${6} _repository;",
      "",
      "  @override",
      "  Future<AppResult<${2}>> call(${5}) => _repository.${7:get}(${8:id});",
      "}"
    ]
  },

  // ------------------------------------------------------------------ datos

  "Datos: DTO freezed con JSON": {
    "scope": "dart",
    "prefix": "sxdto",
    "description": "DTO (data/remote_data_source/<feature>/dto/) que refleja la respuesta del backend (openapi) con fromJson y toDomain()",
    "body": [
      "import 'package:freezed_annotation/freezed_annotation.dart';",
      "",
      "part '${TM_FILENAME_BASE}.freezed.dart';",
      "part '${TM_FILENAME_BASE}.g.dart';",
      "",
      "/// `${1:XxxResponse}` del backend.",
      "@freezed",
      "abstract class ${2:XxxDto} with _\\$${2} {",
      "  const factory ${2}({",
      "    required String id,",
      "    ${3:String? name},",
      "  }) = _${2};",
      "",
      "  const ${2}._();",
      "",
      "  factory ${2}.fromJson(Map<String, dynamic> json) =>",
      "      _\\$${2}FromJson(json);",
      "",
      "  ${4:Modelo} toDomain() => ${4}(id: id${5:, name: name ?? ''});",
      "}"
    ]
  },

  "Datos: fuente remota": {
    "scope": "dart",
    "prefix": "sxremote",
    "description": "Fuente remota (data/remote_data_source/<feature>/): llama a /api/v1/... con Dio y devuelve DTO. Los errores los traduce el repositorio",
    "body": [
      "import 'package:dio/dio.dart';",
      "",
      "import '../api/api_client.dart';",
      "",
      "/// Endpoints de ${1:la funcionalidad} (`/api/v1/${2:recurso}`).",
      "class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} {",
      "  ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}(ApiClient client) : _dio = client.dio;",
      "",
      "  final Dio _dio;",
      "",
      "  static const _base = '/api/v1/${2}';",
      "",
      "  Future<${3:XxxDto}> ${4:get}(String id) async {",
      "    final r = await _dio.get<Map<String, dynamic>>('\\$_base/\\$id');",
      "    return ${3}.fromJson(r.data!);",
      "  }",
      "}"
    ]
  },

  "Datos: método de endpoint": {
    "scope": "dart",
    "prefix": "sxendpoint",
    "description": "Un endpoint más en una fuente remota: elige el verbo de Dio",
    "body": [
      "Future<${1:XxxDto}> ${2:accion}(${3:String id}) async {",
      "  final r = await _dio.${4|get,post,put,patch,delete|}<Map<String, dynamic>>(",
      "    '\\$_base/${5:\\$id}',",
      "    ${6:data: {'campo': valor\\},}",
      "  );",
      "  return ${1}.fromJson(r.data!);",
      "}"
    ]
  },

  "Datos: repositorio": {
    "scope": "dart",
    "prefix": "sxrepo",
    "description": "Repositorio (data/repository/) que implementa el contrato: llama a la fuente, convierte con toDomain() y traduce errores con RepositoryErrorHandler.guard",
    "body": [
      "import '../../domain/models/result/app_result.dart';",
      "import '../errors/repository_error_handler.dart';",
      "",
      "/// Implementa [${1:XxxRepositoryContract}] con [${2:XxxRemoteDataSource}].",
      "class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} implements ${1} {",
      "  const ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}(this._remote);",
      "",
      "  final ${2} _remote;",
      "",
      "  @override",
      "  Future<AppResult<${3:Modelo}>> ${4:get}(String id) =>",
      "      RepositoryErrorHandler.guard(() async => (await _remote.${4}(id)).toDomain());",
      "}"
    ]
  },

  // ----------------------------------------------------------- presentación

  "BLoC: archivo del bloc": {
    "scope": "dart",
    "prefix": "sxbloc",
    "description": "Bloc con freezed y sus partes _event/_state (screens/<feature>/<pantalla>/bloc/). El archivo debe llamarse <pantalla>_bloc.dart. Regístralo con sxdifactory",
    "body": [
      "import 'package:flutter_bloc/flutter_bloc.dart';",
      "import 'package:freezed_annotation/freezed_annotation.dart';",
      "",
      "import '${2:../../../../../domain/errors/app_error.dart}';",
      "",
      "part '${TM_FILENAME_BASE}.freezed.dart';",
      "part '${TM_FILENAME_BASE/(.*)_bloc$/$1/}_event.dart';",
      "part '${TM_FILENAME_BASE/(.*)_bloc$/$1/}_state.dart';",
      "",
      "/// ${1:Qué gestiona esta pantalla}.",
      "class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}",
      "    extends Bloc<${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}Event, ${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}State> {",
      "  ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}({required this._${3:getXxx}})",
      "    : super(const ${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}State.loading()) {",
      "    on<${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}Started>((event, emit) async {",
      "      emit(const ${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}State.loading());",
      "      final result = await _${3}(event.id);",
      "      emit(",
      "        result.fold(",
      "          ${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}State.loaded,",
      "          ${TM_FILENAME_BASE/(.*)_bloc$/${1:/pascalcase}/}State.failure,",
      "        ),",
      "      );",
      "    });",
      "  }",
      "",
      "  final ${4:GetXxxUseCaseContract} _${3};",
      "}"
    ]
  },

