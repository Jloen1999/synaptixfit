  "Configuración: BeanConfiguration de un módulo": {
    "scope": "java",
    "prefix": "sxbeans",
    "description": "infrastructure/config/<Feature>BeanConfiguration: puertos por constructor, servicio con autowireCandidate = false y un bean por contrato envuelto con tx.wrap (transacción)",
    "body": [
      "import org.springframework.context.annotation.Bean;",
      "import org.springframework.context.annotation.Configuration;",
      "",
      "/** Composición de ${1:la funcionalidad}: ${2:qué casos de uso registra}. */",
      "@Configuration",
      "public class ${TM_FILENAME_BASE} {",
      "",
      "    private final TransactionalUseCaseFactory tx;",
      "    private final ${3:XxxRepositoryPort} ${4:repository};",
      "    private final Clock clock;",
      "",
      "    public ${TM_FILENAME_BASE}(TransactionalUseCaseFactory tx, ${3} ${4}, Clock clock) {",
      "        this.tx = tx;",
      "        this.${4} = ${4};",
      "        this.clock = clock;",
      "    }",
      "",
      "    @Bean(autowireCandidate = false)",
      "    ${5:XxxService} ${5/(.)(.*)/${1:/downcase}$2/}() {",
      "        return new ${5}(${4}, clock);",
      "    }",
      "",
      "    @Bean",
      "    ${6:XxxUseCase} ${6/(.)(.*)/${1:/downcase}$2/}() {",
      "        return tx.wrap(${6}.class, ${5/(.)(.*)/${1:/downcase}$2/}());",
      "    }",
      "}"
    ]
  },

