  // Snippets del backend de SynaptixFit (Spring Boot hexagonal). Todos empiezan por «sx» (SynaptixFit): escribe «sx» y verás la
  // lista con su descripción. Siguen backend/CLAUDE.md: Javadoc de cabecera, casos de uso sin Spring, beans
  // envueltos con TransactionalUseCaseFactory, errores con `code` y el usuario siempre desde el JWT.
  // El `package` lo escribe solo la extensión de Java al crear el archivo.

  // ---------------------------------------------------------------- dominio

  "Dominio: excepción con code": {
    "scope": "java",
    "prefix": "sxexception",
    "description": "Excepción de dominio (domain/exception/<feature>/) que extiende una categoría; el GlobalExceptionHandler saca de ella el estado HTTP. Añade el code a docs/03-api/errors.md",
    "body": [
      "import com.synaptixfit.domain.exception.${1|NotFoundException,ConflictException,BusinessRuleException,InvalidInputException,ForbiddenOperationException|};",
      "",
      "/** ${2:Cuándo ocurre, en lenguaje de negocio}. */",
      "public class ${TM_FILENAME_BASE} extends ${1} {",
      "",
      "    public ${TM_FILENAME_BASE}(${3:UUID id}) {",
      "        super(\"${4:FEATURE_REASON}\", \"${5:Detalle técnico en inglés}\");",
      "    }",
      "}"
    ]
  },

